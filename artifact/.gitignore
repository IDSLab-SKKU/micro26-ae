# Generated figure outputs — regenerate with the figure scripts.
# (figure*.csv is already covered by the repo-root *.csv rule.)
figure*.png

# Experiment result outputs — produced by run_experiment.py, kept local only.
# (The results/ directories are preserved by their .gitkeep files.)
**/results/*.json
# Temp file of a result being written; renamed into place once complete.
**/results/*.json.tmp
# Lab security: exclude local editor configuration
.vscode/
.cursor/
